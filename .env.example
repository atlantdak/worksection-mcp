# Auth mode: admin_key (no browser flow) or oauth (per-user browser login)
AUTH_MODE=admin_key

# --- admin_key mode ---------------------------------------------------------
# Bare account slug from https://<slug>.worksection.com
WORKSECTION_ACCOUNT=your-account
WORKSECTION_API_KEY=

# --- oauth mode -------------------------------------------------------------
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_REDIRECT_PORT=18030
# Generate with: python -m worksection_mcp.auth.token_store
# FERNET_KEY=

# --- safety -----------------------------------------------------------------
# Destructive tools (delete_task, delete_comment, delete_costs) are only
# registered when this is true.
ALLOW_DESTRUCTIVE_OPERATIONS=false
# Absolute path to the only directory upload_file may read from.
# FILE_WORKSPACE_DIR=/absolute/path/to/workspace

# --- behaviour --------------------------------------------------------------
# STATE_DIR=~/.worksection-mcp
# REQUEST_TIMEOUT_SECONDS=30
# MAX_RETRIES=3
# RATE_LIMIT_RPS=3
# CACHE_ENABLED=true
# CACHE_TTL_SECONDS=60
# OFFLOAD_THRESHOLD_BYTES=50000
# LOG_LEVEL=INFO
